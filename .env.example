# =============================================================================
# Supabase PostgreSQL Configuration
# =============================================================================

# Supabase REST Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API Key (anon key or service-role key)
# Aliases supported: SUPABASE_KEY, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_KEY=your-supabase-key

# Direct or Connection Pooler PostgreSQL Connection String
# Aliases supported: SUPABASE_DB_URL, DATABASE_URL, POSTGRES_URL
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# =============================================================================
# LLM API & Application Settings
# =============================================================================
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional Alternative LLM Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

ENV=development
LOG_LEVEL=INFO
